# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Supabase -> Project Settings -> API).
#
# IMPORTANTE: use a "service_role" key aqui, NÃO a "anon" key usada no
# auth_and_db.js. A service_role ignora RLS, que é o que este script precisa
# pra conseguir escrever na tabela "clientes" (que é somente-leitura pra
# qualquer usuário logado no app).
SUPABASE_URL=https://fjfzeedzuzjcxpvxebjf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY

# Caminho da planilha. Por padrão assume que está na raiz do projeto, um nível
# acima da pasta scripts/.
XLSX_PATH=../Base Clientes.xlsx
